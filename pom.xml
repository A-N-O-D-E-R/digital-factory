<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>io.github.a-n-o-d-e-r</groupId>
    <artifactId>digital-factory</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Digital Factory</name>
    <description>Autonomous software factory: from ticket to pull request, autonomy earned by evaluation</description>

    <modules>
        <module>factory-contracts</module>
        <module>factory-backend</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <starter-collection.version>0.1.0-SNAPSHOT</starter-collection.version>
        <workflow-starter.version>0.1.0-SNAPSHOT</workflow-starter.version>
        <spring-modulith.version>2.1.1</spring-modulith.version>
        <json-schema-validator.version>3.0.8</json-schema-validator.version>
        <springdoc.version>3.1.1</springdoc.version>
        <!-- as the starter collection's notion-sdk-jvm-core -->
        <notion-sdk-jvm.version>1.11.1</notion-sdk-jvm.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.modulith</groupId>
                <artifactId>spring-modulith-bom</artifactId>
                <version>${spring-modulith.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.github.a-n-o-d-e-r</groupId>
                <artifactId>springboot-starter-collection-dependencies</artifactId>
                <version>${starter-collection.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.github.a-n-o-d-e-r</groupId>
                <artifactId>factory-contracts</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.a-n-o-d-e-r</groupId>
                <artifactId>workflow-spring-boot-starter</artifactId>
                <version>${workflow-starter.version}</version>
            </dependency>
            <dependency>
                <groupId>com.networknt</groupId>
                <artifactId>json-schema-validator</artifactId>
                <version>${json-schema-validator.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.seratch</groupId>
                <artifactId>notion-sdk-jvm-httpclient</artifactId>
                <version>${notion-sdk-jvm.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
