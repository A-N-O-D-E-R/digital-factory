{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Secret scan evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["findings"],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "rule"],
        "properties": {
          "path": { "type": "string" },
          "line": { "type": "integer" },
          "rule": { "type": "string" }
        }
      }
    }
  }
}
