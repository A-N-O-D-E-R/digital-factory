{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Acceptance specification",
  "description": "Executable acceptance tests written from the plan; kept from the implementer.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tests", "command"],
  "properties": {
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "content"],
        "properties": {
          "path": { "type": "string", "pattern": "^[^/][^\\u0000]*$" },
          "content": { "type": "string" }
        }
      }
    },
    "command": { "type": "string", "description": "Command running only these tests, from the repository root." },
    "notes": { "type": "string" }
  }
}
