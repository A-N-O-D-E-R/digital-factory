{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Feedback triage",
  "description": "What to do with each piece of PR feedback.",
  "type": "object",
  "additionalProperties": false,
  "required": ["items", "summary"],
  "properties": {
    "summary": { "type": "string" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "decision"],
        "properties": {
          "id": { "type": "string", "description": "Comment, review or check id from the input." },
          "decision": { "enum": ["CHANGE", "ANSWER", "OUT_OF_SCOPE", "ALREADY_DONE"] },
          "answer": { "type": "string", "description": "Reply to post in the thread." }
        }
      }
    }
  }
}
