{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a-n-o-d-e-r.github.io/digital-factory/contracts/workflow-definition.schema.json",
  "title": "Workflow definition",
  "description": "A workflow: steps (agent, factory action, human gate) linked by ordered transitions. The first transition whose condition holds is taken; a step's last transition must be unconditional.",
  "type": "object",
  "additionalProperties": false,
  "required": ["start", "steps"],
  "properties": {
    "description": { "type": "string" },
    "start": { "$ref": "#/$defs/stepId" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "stepId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
    "target": {
      "description": "A step id, or a terminal outcome.",
      "anyOf": [
        { "$ref": "#/$defs/stepId" },
        { "enum": ["@done", "@blocked", "@failed", "@cancelled"] }
      ]
    },
    "step": {
      "type": "object",
      "required": ["id", "kind", "next"],
      "properties": {
        "id": { "$ref": "#/$defs/stepId" },
        "kind": { "enum": ["agent", "factory", "gate"] },
        "next": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/transition" }
        },
        "settings": {
          "description": "Per-step overrides: model, maxTurns, effort, timeout, retries, resources, tools.",
          "type": "object"
        }
      },
      "oneOf": [
        {
          "properties": {
            "kind": { "const": "agent" },
            "roles": {
              "description": "Agent roles run in parallel for this step (one run each).",
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
            },
            "join": {
              "description": "How the verdicts of parallel runs combine.",
              "enum": ["all", "majority", "any"],
              "default": "all"
            }
          },
          "required": ["roles"]
        },
        {
          "properties": {
            "kind": { "const": "factory" },
            "action": {
              "enum": [
                "run-tests",
                "secret-scan",
                "push-branch",
                "open-draft-pr",
                "mark-pr-ready",
                "request-review",
                "merge",
                "comment-ticket",
                "transition-ticket",
                "watch-pr"
              ]
            },
            "with": { "type": "object" }
          },
          "required": ["action"]
        },
        {
          "properties": {
            "kind": { "const": "gate" },
            "gate": { "description": "What the human decides on.", "enum": ["plan", "final"] },
            "when": {
              "description": "The gate only waits for a human when this holds; otherwise it is passed through.",
              "$ref": "#/$defs/condition"
            }
          },
          "required": ["gate"]
        }
      ]
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["to"],
      "properties": {
        "when": { "$ref": "#/$defs/condition" },
        "to": { "$ref": "#/$defs/target" },
        "maxVisits": {
          "description": "How many times this transition may be taken for one work order; beyond, onExhausted applies.",
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "onExhausted": { "$ref": "#/$defs/target", "default": "@blocked" }
      }
    },
    "fact": {
      "enum": [
        "type",
        "risk",
        "analysis.valid",
        "analysis.reproduced",
        "diff.empty",
        "diff.files",
        "tests.passed",
        "acceptance.passed",
        "secrets.found",
        "verdict",
        "approval",
        "pr.open",
        "pr.event",
        "pr.checks.passed",
        "pr.mergeable",
        "autonomy.allows"
      ]
    },
    "condition": {
      "description": "A closed set of predicates over facts; never code.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["fact"],
          "properties": {
            "fact": { "$ref": "#/$defs/fact" },
            "equals": { "type": ["string", "number", "boolean"] },
            "in": { "type": "array", "minItems": 1, "items": { "type": ["string", "number"] } },
            "greaterThan": { "type": "number" },
            "lessThan": { "type": "number" }
          },
          "minProperties": 2,
          "maxProperties": 2
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["allOf"],
          "properties": { "allOf": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["anyOf"],
          "properties": { "anyOf": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["not"],
          "properties": { "not": { "$ref": "#/$defs/condition" } }
        }
      ]
    }
  }
}
